{
  "name": "@openglobus/openglobus-react",
  "version": "1.0.1",
  "description": "OpenGlobus React Components",
  "main": "./dist/index.umd.cjs",
  "private": false,
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "type": "module",
  "files": [
    "dist/index.*",
    "dist/types"
  ],
  "scripts": {
    "dev": "storybook dev -p 8000",
    "test": "npm run typecheck",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false",
    "build": "vite build",
    "build:watch": "vite build --watch && tsc",
    "storybook": "storybook dev -p 8000",
    "build-storybook": "storybook build",
    "prepublishOnly": "npm run test && npm run build"
  },
  "keywords": [
    "3d",
    "react",
    "react-components",
    "openglobus",
    "gis"
  ],
  "author": "Pavel Sukhodolski",
  "license": "MIT",
  "peerDependencies": {
    "@openglobus/og": "1.0.0-rc15",
    "react": "^19.2.0"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.3.0",
    "@openglobus/og": "1.0.0-rc15",
    "@storybook/addon-docs": "^10.5.6",
    "@storybook/addon-links": "^10.5.6",
    "@storybook/react-vite": "^10.5.6",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@typescript/typescript6": "^6.0.2",
    "react": "^19.2.8",
    "storybook": "^10.5.6",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vite-plugin-dts": "^5.0.3"
  }
}
